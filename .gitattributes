# Windows scripts need CRLF (cmd mis-parses labels in LF files); shell scripts need LF.
*.bat   text eol=crlf
*.ps1   text eol=crlf
*.sh    text eol=lf

# Frontend sources are LF on every OS, so `npm run build` produces byte-identical output on
# Windows and on CI (which checks that the committed build matches the sources).
frontend/** text=auto eol=lf

# Prebuilt frontend: stored byte-for-byte, never diffed or normalised.
backend/paperlook/static/** -text -diff
*.ico   binary
*.png   binary
*.woff2 binary
*.woff  binary
*.ttf   binary
